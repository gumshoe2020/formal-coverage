"""FLOOR REPORT DIFF; requires the committed baseline to match the measurement."""
import argparse
import json
from pathlib import Path
import sys
from coverage_lib import check

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('floor', type=Path)
p.add_argument('report', type=Path)
p.add_argument('diff', type=Path)
p.add_argument('--committed', type=Path, default=Path('coverage/baseline.json'))
p.add_argument('--coverage', type=Path, default=Path('COVERAGE.md'))
p.add_argument('--commit', action='append', default=[], help='full commit in the checked range; repeatable')
a = p.parse_args()
try:
    errors = check(json.loads(a.floor.read_text()), json.loads(a.committed.read_text()),
                   json.loads(a.report.read_text()), a.diff.read_text(), a.coverage.read_text(), a.commit)
except (ValueError, KeyError, OSError, TypeError) as exc:
    print(f'ratchet FAIL: {exc}', file=sys.stderr)
    sys.exit(1)
print('ratchet PASS' + (' (maintainer exception: ' + '; '.join(errors) + ')' if errors else ''))
